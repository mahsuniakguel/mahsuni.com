# Copy to .env.local and fill in. Never commit real keys.

# Required. Get a free key at https://console.groq.com/keys
CHAT_API_KEY=

# Optional. One of: groq (default), gemini, openrouter.
# gemini:     free key at https://aistudio.google.com/apikey
# openrouter: free key at https://openrouter.ai/keys (use a ":free" model)
# CHAT_PROVIDER=groq

# Optional for groq (defaults to llama-3.3-70b-versatile), required otherwise.
# CHAT_MODEL=

# Optional. Any other OpenAI-compatible endpoint, e.g. a local Ollama server
# at http://localhost:11434/v1. Overrides the provider's base URL.
# CHAT_BASE_URL=
